// 12. Event Listeners & UI Binding
// ==========================================
// Difficulty Switchers
diffButtons.forEach(btn => {
  btn.addEventListener('click', () => {
    const diff = btn.dataset.difficulty;
    if (diff && DIFFICULTY_CONFIG[diff]) {
      initGame(diff);
    }
  });
});

// Restart Button
restartBtn.addEventListener('click', () => {
  initGame();
});

